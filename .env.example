# Copy this file to ".env" and fill in your own values.
# Docker Compose reads ".env" automatically. Never commit ".env".

# SQL Server SA password (must meet SQL Server complexity rules:
# 8+ chars, upper, lower, digit, symbol)
MSSQL_SA_PASSWORD=change-me-strong-password

# JWT signing key (use a long random string, 32+ characters)
JWT_KEY=change-me-long-random-string

# Gmail app password for SMTP mail sending
MAIL_APP_PASSWORD=your-gmail-app-password

# Hangfire dashboard login
HANGFIRE_USERNAME=admin
HANGFIRE_PASSWORD=change-me
